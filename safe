SB

# Emitted AFTER every allow so SBPL's last-match-wins keeps these inviolable.
HARD_DENIES = <<~SB
  (deny network-outbound
    (remote unix-socket (path-literal "/var/run/docker.sock"))
    (remote unix-socket (path-literal "/private/var/run/docker.sock")))

  (deny file-read* file-write*
    (regex #"^/private/tmp/com\\.apple\\.launchd\\.[^/]+/Listeners$")
    (regex #"^/tmp/com\\.apple\\.launchd\\.[^/]+/Listeners$"))
SB

def esc(s)
  s.gsub(/[\\"]/) { |c| '\\' + c }
end

def matcher(path)
  if    path.end_with?('/')   then [:subpath, path.chomp('/')]
  elsif path.end_with?('*')   then [:prefix,  path.chomp('*')]
  elsif File.directory?(path) then [:subpath, path]
  else                             [:literal, path]
  end
end

def ancestors_of(target)
  parts = target.split('/').reject(&:empty?)
  ['/'] + (1..parts.length).map { |i| '/' + parts[0, i].join('/') }
end

def allow_target(path)
  _, target = matcher(File.expand_path(path))
  target
end

def allow_rule(path, modes)
  abs = File.expand_path(path)
  match, target = matcher(abs)
  ops = modes.map { |m| m == :read ? 'file-read*' : 'file-write*' }.join(' ')
  lines = [%[(allow #{ops} (#{match} "#{esc(target)}"))]]
  real = File.realpath(target) rescue nil
  lines << %[(allow #{ops} (#{match} "#{esc(real)}"))] if real && real != target
  lines.join("\n")
end

def deny_rule(path, modes)
  abs = File.expand_path(path)
  match, target = matcher(abs)
  ops = modes.map { |m| m == :read ? 'file-read*' : 'file-write*' }.join(' ')
  %[(deny #{ops} (#{match} "#{esc(target)}"))]
end

def load_cfg(path)
  return {} unless File.exist?(path)
  YAML.safe_load(File.read(path)) || {}
end

def canonicalize(obj)
  case obj
  when Hash  then obj.sort.to_h.transform_values { |v| canonicalize(v) }
  when Array then obj.map { |v| canonicalize(v) }
  else obj
  end
end

def merge_cfg(team, local)
  {
    'network' => local['network'] || team['network'] || 'open',
    'use'     => (Array(team['use']) + Array(local['use'])).uniq,
    'aws'     => local['aws'] || team['aws'],
    'allow'   => {
      'read'  => (Array(team.dig('allow', 'read'))  + Array(local.dig('allow', 'read'))).uniq,
      'write' => (Array(team.dig('allow', 'write')) + Array(local.dig('allow', 'write'))).uniq,
    },
    'deny'    => {
      'read'  => (Array(team.dig('deny', 'read'))   + Array(local.dig('deny', 'read'))).uniq,
      'write' => (Array(team.dig('deny', 'write'))  + Array(local.dig('deny', 'write'))).uniq,
    },
    'append'  => [team['append'], local['append']].compact.reject(&:empty?).join("\n\n"),
  }
end

def render_policy(cfg)
  reads  = Array(cfg.dig('allow', 'read'))
  writes = Array(cfg.dig('allow', 'write'))
  machs  = []
  cfg['use'].each do |name|
    recipe = RECIPES.fetch(name) { abort "safe: unknown recipe #{name.inspect}" }
    reads  += Array(recipe['read'])
    writes += Array(recipe['write'])
    machs  += Array(recipe['mach'])
  end

  network = NETWORK.fetch(cfg['network']) {
    abort "safe: unknown network mode #{cfg['network'].inspect} (use: #{NETWORK.keys.join(', ')})"
  }

  mach_section = machs.empty? ? nil : [
    ';; Recipe mach services',
    "(allow mach-lookup\n  " +
      machs.uniq.map { |n| %[(global-name "#{esc(n)}")] }.join("\n  ") + ')',
  ]

  aws_cache = cfg.dig('aws', 'profile') ? File.join(CACHE, 'aws', cfg.dig('aws', 'profile')) : nil

  # sandbox-exec needs read access on every parent directory to traverse
  # into an allowed path. Collect ancestors for every allow target and emit
  # one deduplicated block — emitting per-rule produced hundreds of repeated
  # `(literal "/")`, `(literal "/Users")`, … entries in non-trivial policies.
  allow_paths = reads.uniq + writes.uniq + [WORKTREE_MAIN, ROOT, WORKTREE_MAIN_GIT, aws_cache].compact
  ancestors = allow_paths.flat_map { |p| ancestors_of(allow_target(p)) }.uniq
  ancestor_block = [
    ';; Ancestor read access (shared by every allow rule below)',
    "(allow file-read*\n  " + ancestors.map { |a| %[(literal "#{esc(a)}")] }.join(' ') + ')',
  ]

  sections = [
    BASELINE,
    ";; Network: #{cfg['network']}",
    network,
    mach_section,
    ancestor_block,
    *reads.uniq.map  { |p| allow_rule(p, [:read]) },
    *writes.uniq.map { |p| allow_rule(p, [:read, :write]) },
    (WORKTREE_MAIN ? [';; Worktree: main repo (read-only)', allow_rule(WORKTREE_MAIN, [:read])] : nil),
    ';; Project root',
    allow_rule(ROOT, [:read, :write]),
    (WORKTREE_MAIN_GIT ? [';; Worktree: main repo .git', allow_rule(WORKTREE_MAIN_GIT, [:read, :write])] : nil),
    (aws_cache ? [';; AWS credentials (cached under ~/.cache/safe/aws/<profile>)', allow_rule(aws_cache, [:read])] : nil),
    (cfg['append'].empty? ? nil : [';; User append', cfg['append']]),
    ';; Hard denies (emitted last — SBPL last-match-wins makes these inviolable)',
    HARD_DENIES,
    (cfg.dig('aws', 'profile') ? %[(deny file-read* (subpath "#{esc(File.expand_path('~/.aws'))}"))] : nil),
    %[(deny file-write* (regex #"^#{Regexp.escape(ROOT)}/\\.safe(\\.local)?\\.yml$"))],
    (WORKTREE_MAIN ? %[(deny file-write* (regex #"^#{Regexp.escape(WORKTREE_MAIN)}/\\.safe(\\.local)?\\.yml$"))] : nil),
    *Array(cfg.dig('deny', 'read')).map  { |p| deny_rule(p, [:read]) },
    *Array(cfg.dig('deny', 'write')).map { |p| deny_rule(p, [:write]) },
  ]
  sections.compact.flatten.join("\n\n") + "\n"
end

FileUtils.mkdir_p(CACHE)

canonical_inputs = [
  ROOT,
  WORKTREE_MAIN_GIT.to_s,
  YAML.dump(canonicalize(load_cfg(PROJECT_YML))),
  YAML.dump(canonicalize(load_cfg(LOCAL_YML))),
  WORKTREE_MAIN_YML ? YAML.dump(canonicalize(load_cfg(WORKTREE_MAIN_YML))) : '',
  File.read(__FILE__),
  ENV['HOME'].to_s,
].join("\0")
key = Digest::SHA256.hexdigest(canonical_inputs)[0, 16]
policy = File.join(CACHE, "policy-#{key}.sb")

cfg = merge_cfg(load_cfg(PROJECT_YML), load_cfg(LOCAL_YML))

# Inherit deny rules from the main worktree's .safe.yml so the read grant on
# the main worktree can't bypass paths the team has marked off-limits there.
# Relative paths in the main config resolve against the main worktree, not cwd.
if WORKTREE_MAIN_YML
  main_cfg = load_cfg(WORKTREE_MAIN_YML)
  rebase = ->(p) { File.expand_path(p, WORKTREE_MAIN) }
  cfg['deny']['read']  = (cfg['deny']['read']  + Array(main_cfg.dig('deny', 'read')).map(&rebase)).uniq
  cfg['deny']['write'] = (cfg['deny']['write'] + Array(main_cfg.dig('deny', 'write')).map(&rebase)).uniq
end

# Per-profile credential cache. Determined (and created) before render_policy
# so allow_rule picks the :subpath matcher via File.directory? even on first run.
aws_dir = nil
if (profile = cfg.dig('aws', 'profile'))
  abort "safe: invalid AWS profile name #{profile.inspect}" unless profile.match?(/\A[\w\-\.]+\z/) && profile != '.' && profile != '..'
  aws_dir = File.join(CACHE, 'aws', profile)
  FileUtils.mkdir_p(aws_dir, mode: 0o700)
end

File.write(policy, render_policy(cfg)) unless File.exist?(policy)

# AWS profile gating: cache resolved credentials under
# ~/.cache/safe/aws/<profile>/ and refresh before they expire. A flock on
# <aws_dir>/lock serializes refresh work across concurrent sessions that
# share a profile. meta.json records the expiration so stale credentials
# can be detected without shelling out to `aws`.
AWS_REFRESH_LEEWAY = 300  # seconds before expiry at which we refresh

def aws_export(profile)
  out = IO.popen(['aws', 'configure', 'export-credentials', '--profile', profile, '--format', 'process'], err: [:child, :out], &:read)
  raise "aws export-credentials for profile #{profile} failed: #{out.strip}" unless $?.success?
  JSON.parse(out)
end

# Write under [default] AND [<profile>] so clients work whether AWS_PROFILE is
# unset (defaults to "default") or set to the profile name — e.g. when claude
# re-injects AWS_PROFILE from its own settings, the section still matches.
def aws_write_creds(path, c, profile)
  section = ->(name) do
    s = +"[#{name}]\naws_access_key_id = #{c['AccessKeyId']}\naws_secret_access_key = #{c['SecretAccessKey']}\n"
    s << "aws_session_token = #{c['SessionToken']}\n" if c['SessionToken']
    s
  end
  body = section.call('default')
  body << "\n" << section.call(profile) unless profile == 'default'
  File.write("#{path}.tmp", body)
  File.chmod(0o600, "#{path}.tmp")
  File.rename("#{path}.tmp", path)
end

def aws_write_config(path, region, profile)
  body = +"[default]\n"
  body << "region = #{region}\n" unless region.empty?
  unless profile == 'default'
    body << "\n[profile #{profile}]\n"
    body << "region = #{region}\n" unless region.empty?
  end
  File.write(path, body)
end

# :missing — no cached meta yet. :never — static creds with no expiration.
def aws_meta_expiration(aws_dir)
  meta_path = File.join(aws_dir, 'meta.json')
  return :missing unless File.exist?(meta_path)
  meta = JSON.parse(File.read(meta_path)) rescue nil
  return :missing unless meta
  return :never if meta['expiration'].nil?
  Time.parse(meta['expiration']) rescue :missing
end

def aws_creds_stale?(aws_dir)
  exp = aws_meta_expiration(aws_dir)
  return true  if exp == :missing
  return false if exp == :never
  exp - Time.now < AWS_REFRESH_LEEWAY
end

def aws_ensure_fresh!(aws_dir, profile)
  return unless aws_creds_stale?(aws_dir)
  File.open(File.join(aws_dir, 'lock'), File::RDWR | File::CREAT, 0o600) do |lock|
    lock.flock(File::LOCK_EX)
    return unless aws_creds_stale?(aws_dir)  # another session may have refreshed while we waited
    region = (IO.popen(['aws', 'configure', 'get', 'region', '--profile', profile], err: File::NULL, &:read).strip rescue '')
    aws_write_config(File.join(aws_dir, 'config'), region, profile)
    creds = aws_export(profile)
    aws_write_creds(File.join(aws_dir, 'credentials'), creds, profile)
    File.write(File.join(aws_dir, 'meta.json'), JSON.dump('expiration' => creds['Expiration']))
  end
end

if aws_dir
  begin
    aws_ensure_fresh!(aws_dir, profile)
  rescue => e
    abort "safe: #{e.message}"
  end

  Thread.new do
    loop do
      exp = aws_meta_expiration(aws_dir)
      break if exp == :never
      sleep(exp == :missing ? 60 : [(exp - Time.now - AWS_REFRESH_LEEWAY), 60].max)
      begin
        aws_ensure_fresh!(aws_dir, profile)
      rescue => e
        warn "safe: AWS credential refresh failed: #{e.message}"
        sleep 30
      end
    end
  end

  ENV.keys.grep(/^AWS_/).each { |k| ENV.delete(k) }
  ENV['AWS_SHARED_CREDENTIALS_FILE'] = File.join(aws_dir, 'credentials')
  ENV['AWS_CONFIG_FILE'] = File.join(aws_dir, 'config')
end

pid = Process.spawn('sandbox-exec', '-f', policy, '--', *agent_argv(ARGV))

# Terminal signals (INT/TSTP/CONT) are delivered to the whole pgrp, so the child
# gets them alongside us — we just need to keep Ruby from exiting on INT.
Signal.trap('INT') { }
# Explicit kills to the parent don't hit the child; forward them.
%w[TERM HUP QUIT].each { |s| Signal.trap(s) { Process.kill(s, pid) rescue nil } }

Process.wait(pid)

status = $?
if status.signaled?
  Signal.trap(status.termsig, 'DEFAULT')
  Process.kill(status.termsig, Process.pid)
else
  exit status.exitstatus
end
